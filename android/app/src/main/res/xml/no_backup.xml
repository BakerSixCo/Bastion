<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing BASTION stores (library, mesh inbox, settings, model) is copied to
     cloud backup or to another device. Private data stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" />
        <exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
