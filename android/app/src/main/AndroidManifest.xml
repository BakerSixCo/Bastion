<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Deliberately NO android.permission.INTERNET: the offline guarantee is
         structural. v0.1 cannot transmit anything, to anyone. If a later
         milestone adds a model-download setup mode, that becomes an explicit,
         documented decision. -->

    <!-- Lets BASTION bind to BASTION Link (the separate, network-capable bridge to the
         Meshtastic app's local TAK server). Signature-level: only apps signed with the same
         key hold it. Declared here too so install order doesn't matter. This is NOT a
         network permission — BASTION still cannot open a socket. -->
    <permission
        android:name="com.bastion.permission.LINK"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.bastion.permission.LINK" />

    <queries>
        <package android:name="org.kiwix.kiwixmobile" />
        <package android:name="com.geeksville.mesh" />
        <package android:name="com.atakmap.app.civ" />
        <package android:name="app.organicmaps" />
        <package android:name="com.bastion.link" />
    </queries>

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        tools:replace="android:allowBackup"
        android:dataExtractionRules="@xml/no_backup"
        android:fullBackupContent="@xml/no_backup_legacy"
        android:theme="@style/Theme.Bastion">
        <!-- GPU backend (LiteRT-LM via OpenCL). Optional: absent on the emulator and some
             phones, where Auto falls back to CPU. Android 12+ needs these declared. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Mesh inbox: reads the Meshtastic app's message notifications (and nothing else —
             filtered in code). Runs only if the user grants notification access in Android
             settings. Not a network or Bluetooth capability; no uses-permission is added. -->
        <service
            android:name=".mesh.MeshInboxService"
            android:exported="true"
            android:label="BASTION mesh inbox"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
