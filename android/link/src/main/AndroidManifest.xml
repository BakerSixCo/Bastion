<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one network-capable BASTION component. Used ONLY for a loopback connection to
         the Meshtastic app's local TAK server (127.0.0.1). The code refuses any other
         address (TakConfig.requireLoopback). Android needs INTERNET even for loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only apps signed with the same key as this one (i.e. BASTION) may bind. -->
    <permission
        android:name="com.bastion.permission.LINK"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".LinkService"
            android:exported="true"
            android:permission="com.bastion.permission.LINK">
            <intent-filter>
                <action android:name="com.bastion.link.BIND" />
            </intent-filter>
        </service>
    </application>
</manifest>
